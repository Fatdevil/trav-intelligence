generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Tävlingsomgången (T.ex. V86 på Solvalla)
model RaceEvent {
  id          String   @id @default(uuid())
  date        DateTime // Datum för tävlingen
  track       String   // Banan (t.ex. Solvalla/Jägersro)
  type        String   // V75, V86, Dagens Dubbel
  races       Race[]
  createdAt   DateTime @default(now())
}

// 2. Själva racen inom omgången
model Race {
  id              String       @id @default(uuid())
  eventId         String
  event           RaceEvent    @relation(fields: [eventId], references: [id])
  raceNumber      Int          // Lopp 1-8 (t ex V86-1)
  distance        Int          // Ex: 2140 eller 1640 meter
  startMethod     String       // Auto eller Volt
  trackCondition  String?      // Lätt, Tung, Kladdig, Regn
  horses          HorseEntry[]
}

// 3. Hästarna (Här lagras fakta före start OCH resultatet efter)
model HorseEntry {
  id            String   @id @default(uuid())
  raceId        String
  race          Race     @relation(fields: [raceId], references: [id])
  startNumber   Int      // Startspår (1-15)
  horseName     String   // Hästens nammn
  driver        String   // Kusken
  trainer       String   // Tränaren
  shoes         String?  // Ex: "BRO" (Barfota Runt Om)
  sulky         String?  // Vanlig eller Jänkarvagn (-/-)
  startOdds     Float?   // Stängningsodds
  streckPercent Float?   // Vinnarprocent (Strecken) från svenska folket
  
  // FACIT FÖR FRAMTIDA UTVÄRDERING 
  actualResult  Int?     // Placering 1, 2, 3, eller 0 vid galopp/oplacerad
}

// 4. Logg på vad AI:n förutspådde
model AI_PredictionLog {
  id              String   @id @default(uuid())
  eventId         String
  strategy        String   // "safe", "ev", "jackpot"
  budget          Float
  promptContext   String   // Texten/Datan vi tryckte in i Claude
  aiRawResponse   String   // Svaret vi fick ut (+ motiveringarna)
  createdAt       DateTime @default(now())
  hasBeenEvaluated Boolean @default(false) // Om den utvärderats post-race
}

// 5. RAG Minnesbanken (Insikter) - Det som gör AI:n smartare över tid!
model CoreInsight {
  id            String   @id @default(uuid())
  category      String   // T.ex. "TrackCondition", "DriverPattern", "ShoeChange"
  insightText   String   // "LÄRDOM: På tunga banor tappar Jänkarvagnar 30% av sin effekt..."
  confidence    Float    // 0.0 - 1.0 (Hur mycket litar AI:n på denna kunskap ännu?)
  updatedAt     DateTime @updatedAt
}

// ==========================================
// FAS 2: PYTHON ML-PIPELINE (Statistisk Modell)
// ==========================================

model MLRace {
  id            String   @id @default(uuid())
  race_date     DateTime
  track_name    String
  race_number   Int
  race_type     String
  distance      Int
  start_type    String
  surface       String?
  prize_money   Float?
  num_starters  Int
  created_at    DateTime @default(now())
  
  starters      MLRaceStarter[]
  @@map("races")
}

model MLHorse {
  id            String   @id @default(uuid())
  horse_name    String
  birth_year    Int?
  country       String?
  gender        String?
  created_at    DateTime @default(now())

  starters      MLRaceStarter[]
  @@map("horses")
}

model MLRaceStarter {
  id                  String   @id @default(uuid())
  race_id             String
  horse_id            String
  post_position       Int
  driver_name         String
  trainer_name        String
  starting_position   Int?
  scratch             Boolean  @default(false)
  final_position      Int?
  finish_time_seconds Float?
  km_time             Float?
  odds_pre_race       Float?
  odds_final          Float?
  shoes_front         Boolean? @default(true)
  shoes_back          Boolean? @default(true)
  sulky_type          String?
  galloped            Boolean? @default(false)
  created_at          DateTime @default(now())

  race                MLRace   @relation(fields: [race_id], references: [id])
  horse               MLHorse  @relation(fields: [horse_id], references: [id])

  features            MLFeature[]
  predictions         MLPrediction[]
  valueBets           MLValueBet[]

  @@unique([race_id, horse_id]) // Prevent duplicate inserts
  @@map("race_starters")
}

model MLFeature {
  id                     String   @id @default(uuid())
  race_id                String
  starter_id             String
  feature_name           String
  feature_value          Float?
  computed_at            DateTime @default(now())
  look_ahead_cutoff_date DateTime

  starter                MLRaceStarter @relation(fields: [starter_id], references: [id])
  @@map("features")
}

model MLPrediction {
  id               String   @id @default(uuid())
  race_id          String
  starter_id       String
  model_version    String
  predicted_prob   Float
  calibrated_prob  Float
  predicted_rank   Int?
  created_at       DateTime @default(now())

  starter          MLRaceStarter @relation(fields: [starter_id], references: [id])
  @@map("predictions")
}

model MLValueBet {
  id               String   @id @default(uuid())
  race_id          String
  starter_id       String
  race_date        DateTime
  track_name       String
  race_number      Int
  horse_name       String
  driver_name      String
  post_position    Int
  model_prob       Float
  market_prob      Float
  decimal_odds     Float
  edge             Float
  expected_value   Float
  kelly_stake      Float
  created_at       DateTime @default(now())

  starter          MLRaceStarter @relation(fields: [starter_id], references: [id])
  @@map("value_bets")
}
